# 10X backend — copy to .env. Never commit the populated file.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3010
# Public address of THIS API. Render fills RENDER_EXTERNAL_URL automatically
# (https://backend-10x.onrender.com); set this only for a custom domain.
# Used for the Cashfree notify_url on every order and printed at startup.
# API_PUBLIC_URL=https://backend-10x.onrender.com

# Database and authentication are environment-only.
MONGODB_URI=
MONGODB_DB=10x
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cashfree — sandbox | production. Use the matching key pair from
# merchant.cashfree.com → Developers → API Keys. Webhook signatures are
# verified with CASHFREE_SECRET_KEY, so the dashboard webhook must be created
# under the same key pair. Production checklist: README → "Production".
CASHFREE_ENV=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Shiprocket API user
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=warehouse
SHIPROCKET_PACKAGE_WEIGHT_KG=0.5

# S3 media and MongoDB backups
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# AWS SES transactional email. Brevo remains available in code but is not linked.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
FROM_EMAIL=
FROM_NAME=10X
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=10X

# Daily backup and backend syncing
BACKUP_ENABLED=true
BACKUP_S3_BUCKETS=
BACKUP_HOUR_IST=3
BACKUP_RETENTION_DAYS=30
SYNC_KEY=
SYNC_INTERVAL_SECONDS=60

# -------------------------------------------------- local test payments
# Settles a checkout as paid WITHOUT a card, so the whole order path can be
# tested locally: order created, stock taken, invoice numbered, email sent.
#
# Ignored entirely when NODE_ENV=production. Never set this on a deployed
# server — it creates paid orders that nobody paid for.
# ALLOW_TEST_PAYMENTS=true
